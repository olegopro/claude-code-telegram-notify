# Шаблон секретов Telegram-бота.
# Скопируйте в ~/.claude/telegram-notify.env и заполните (install.sh делает это сам).
# Этот пример — единственный *.env в репозитории; реальные значения НЕ коммитятся.

# Токен бота от @BotFather (вид: 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# chat_id вашего чата с ботом (из getUpdates, см. README)
TELEGRAM_CHAT_ID=

# Порог уведомления в секундах (опц., по умолчанию 180 = 3 минуты)
# TELEGRAM_MIN_SECONDS=180

# Отключить перевод заголовка треда на русский (приватность — не слать в Google Translate)
# TELEGRAM_TRANSLATE=0

# Вопросы Claude с кнопками (AskUserQuestion). Включаются флагом ~/.claude/telegram-question.on
# Сколько секунд ждать ответа в Telegram (по умолчанию 3300; меньше timeout хука — 3600):
# TELEGRAM_QUESTION_TIMEOUT=3300

# Секунды длинного опроса getUpdates (по умолчанию 5):
# TELEGRAM_QUESTION_LONGPOLL=5

# Адрес Bot API (по умолчанию https://api.telegram.org) — для зеркала или тестов:
# TELEGRAM_API_BASE=https://api.telegram.org
